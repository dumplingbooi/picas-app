<!-- index.html -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Studentu saraksts</title>
</head>
<body>
    <h1>Studenti</h1>
    <ul>
        {% for student in students %}
            <li>{{ student.name }} – {{ student.course }}</li>
        {% endfor %}
    </ul>
    <a href="/grades">Skatīt atzīmes</a><br>
    <a href="/stats">Skatīt statistiku</a><br>
    <a href="/upload">Augšupielādēt CSV</a>
</body>
</html>

<!-- grades.html -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Atzīmes</title>
</head>
<body>
    <h1>Visas atzīmes</h1>
    <table border="1">
        <tr><th>Students</th><th>Priekšmets</th><th>Atzīme</th></tr>
        {% for grade in grades %}
            <tr>
                <td>{{ grade.student.name }}</td>
                <td>{{ grade.subject }}</td>
                <td>{{ grade.grade }}</td>
            </tr>
        {% endfor %}
    </table>
    <a href="/">Atpakaļ</a>
</body>
</html>

<!-- stats.html -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Statistika</title>
</head>
<body>
    <h1>Statistika</h1>
    <p>Vidējā atzīme: {{ avg_grade }}</p>
    <img src="/{{ plot_path }}" alt="Histogramma">
    <a href="/">Atpakaļ</a>
</body>
</html>

<!-- upload.html -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CSV augšupielāde</title>
</head>
<body>
    <h1>Augšupielādēt CSV failu</h1>
    <form method="POST" enctype="multipart/form-data">
        <input type="file" name="csv_file" accept=".csv" required>
        <button type="submit">Augšupielādēt</button>
    </form>
    <a href="/">Atpakaļ</a>
</body>
</html>
